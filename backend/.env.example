# Backend Environment Variables
# ======================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to Git.
# ======================================================

# Server Port
PORT=5000

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/blooddonor
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/blooddonor
MONGO_URI=mongodb://127.0.0.1:27017/blooddonor

# JWT Configuration
# Use a strong random secret in production (min 32 chars)
JWT_SECRET=replace_this_with_a_very_long_random_secret_string
JWT_EXPIRE=7d

# Environment
NODE_ENV=development

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Gmail SMTP for OTP Emails
# Use an App Password (not your main Gmail password)
# Guide: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
